    "recipes": [
      {
        "id": "rec-76c045f9-6c4d-4538-9b89-90c094190251",
        "name": "辣椒炒牛肉",
        "servings": 2,
        "approxMinutes": 20,
        "steps": [
          "牛肉加小苏打、蚝油、老抽、淀粉和水搅拌到黏手，再加油腌制",
          "热锅后下牛肉，先不要动，半分钟定型后炒散",
          "再炒洋葱和辣椒，放点盐",
          "再倒回牛肉，倒入料酒，入味后直接出锅"
        ],
        "createdAt": "2026-09-29T08:16:39.941Z",
        "updatedAt": "2026-09-29T08:16:52.308Z",
        "favorited": false,
        "favoritedAt": null,
        "tags": [
          "hun"
        ]
      }
